# hgs machine setup uploads the CLI sources from Windows checkouts too; the
# peer's shell and interpreters need LF line endings.
*.sh text eol=lf
*.py text eol=lf

# Reviewed official manifests are hash-pinned raw upstream bytes on every host.
scripts/ci/kimi-native-manifests/*.json -text
# A reviewed third-party license is hash-pinned too (collect-licenses.py):
# a Windows checkout must not turn its line endings into CRLF (task 169).
docs/licenses/canonicalpath-LICENSE.txt -text

# The Next Russian catalogs merge as data, not as text: the reviewed supplement
# as a key union and the generated catalog by regeneration
# (scripts/i18n-merge.py, driver `i18n`; Zerus passes it on its merge paths,
# contributors enable it with one git config line, see CONTRIBUTING.md).
client/src/i18n.next-ru.json merge=i18n
client/src/i18n.ru.json merge=i18n

# Captured terminal screens intentionally preserve whitespace and blank lines.
# They and the recorded screen data are embedded with include_str!, so checkouts
# keep their bytes exactly (no CRLF conversion on Windows).
tests/fixtures/*.txt -text -whitespace
# Reviewed reverse-projection patches pin raw bytes, including context whitespace.
tests/fixtures/*.patch -text -whitespace
# SessionStart serialization has a byte-exact UTF-8/LF contract on every host.
tests/fixtures/session-start-context.json -text
# Task #20: compared byte for byte by details_contract; a Windows checkout kept CRLF.
client/core/tests/fixtures/inspect-details.json text eol=lf
src/state/data/*.txt -text -whitespace

# Keep vendored libvterm byte-for-byte identical to the documented upstream.
client/core/tests/fixtures/qt-fork-helper/*.ps1 -text -whitespace

# Design prototypes and artwork are documentation, not application source.
design/** linguist-documentation

.beads export-ignore
.agents export-ignore
.github export-ignore
design export-ignore
AGENTS.md export-ignore
CLAUDE.md export-ignore

# Preserve the upstream Windows Gradle wrapper and CameraX license verbatim.
mobile/android/gradlew.bat -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
mobile/android/app/src/main/assets/licenses/camerax.txt -whitespace

# Third-party license texts for the Windows zip stay byte-for-byte as published.
packaging/windows/licenses/*.txt -whitespace
tests/fixtures/screen-streams/*.bin binary
