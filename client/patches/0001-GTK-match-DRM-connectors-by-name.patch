 namespace WebKit {
 
 #if PLATFORM(GTK)
+static std::span<const char8_t> utf8Span(const char* string)
+{
+    if (!string)
+        return { };
+    return unsafeMakeSpan(byteCast<char8_t>(string), std::char_traits<char>::length(string));
+}
+
+#if USE(GTK4)
+static std::span<const char8_t> monitorConnectorName(GdkMonitor* monitor)
+{
+    return utf8Span(gdk_monitor_get_connector(monitor));
+}
+#else
+static GUniquePtr<char> monitorConnectorName(GdkMonitor* monitor)
+{
+    auto* display = gdk_monitor_get_display(monitor);
+    auto* screen = gdk_display_get_default_screen(display);
+    if (!screen)
+        return { };
+
+    const int monitorCount = gdk_display_get_n_monitors(display);
+    for (int i = 0; i < monitorCount; ++i) {
+        if (gdk_display_get_monitor(display, i) != monitor)
+            continue;
+        ALLOW_DEPRECATED_DECLARATIONS_BEGIN
+        GUniquePtr<char> name(gdk_screen_get_monitor_plug_name(screen, i));
+        ALLOW_DEPRECATED_DECLARATIONS_END
+        return WTF::move(name);
+    }
+    return { };
+}
+#endif
