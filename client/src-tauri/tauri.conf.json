{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zerus Next (dev)",
  "version": "0.1.0",
  "identifier": "dev.zerus.next",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: zerus-file: http://zerus-file.localhost",
        "media-src": "'self' zerus-file: http://zerus-file.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost zerus-file: http://zerus-file.localhost"
      },
      "devCsp": {
        "default-src": "'self' http://127.0.0.1:1420",
        "script-src": "'self' http://127.0.0.1:1420",
        "style-src": "'self' 'unsafe-inline' http://127.0.0.1:1420",
        "img-src": "'self' data: http://127.0.0.1:1420 zerus-file: http://zerus-file.localhost",
        "media-src": "'self' http://127.0.0.1:1420 zerus-file: http://zerus-file.localhost",
        "font-src": "'self' data: http://127.0.0.1:1420",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420 zerus-file: http://zerus-file.localhost"
      },
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
